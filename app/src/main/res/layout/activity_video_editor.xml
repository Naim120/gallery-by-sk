<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/video_editor_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_video_cancel"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close"
            android:contentDescription="Cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Edit Video"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_video_export"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:text="EXPORT"
            android:textColor="#00FF00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="8dp" />
    </RelativeLayout>

    <!-- Video Preview Container -->
    <FrameLayout
        android:id="@+id/video_preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/video_editor_top_bar"
        app:layout_constraintBottom_toTopOf="@id/layout_video_playback_progress"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <TextureView
            android:id="@+id/video_editor_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <com.sk.gallery.ui.viewer.CropOverlayView
            android:id="@+id/crop_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Play/Pause Overlay Button -->
        <ImageView
            android:id="@+id/btn_video_play_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play"
            android:background="@android:color/transparent"
            android:contentDescription="Play/Pause"
            android:alpha="0.8" />
    </FrameLayout>

    <!-- Playback Progress Row -->
    <LinearLayout
        android:id="@+id/layout_video_playback_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="#161616"
        app:layout_constraintBottom_toTopOf="@id/layout_sub_options_container">

        <TextView
            android:id="@+id/tv_playback_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekbar_playback"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:progressTint="#00FF00"
            android:thumbTint="#FFFFFF" />

        <TextView
            android:id="@+id/tv_playback_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Sub-options Container -->
    <FrameLayout
        android:id="@+id/layout_sub_options_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toTopOf="@id/video_editor_bottom_bar">

        <!-- Trim Options Layout -->
        <LinearLayout
            android:id="@+id/layout_video_trim_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_trim_start"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="center" />

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/range_slider_trim"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:thumbColor="#FFFFFF"
                app:trackColorActive="#00FF00"
                app:trackColorInactive="#555555" />

            <TextView
                android:id="@+id/tv_trim_end"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Sound Options Layout -->
        <LinearLayout
            android:id="@+id/layout_video_sound_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/img_sound_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_volume_up"
                app:tint="#FFFFFF" />

            <SeekBar
                android:id="@+id/seekbar_volume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="100"
                android:progressTint="#00FF00"
                android:thumbTint="#FFFFFF" />

            <TextView
                android:id="@+id/tv_volume_percentage"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:gravity="center"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Rotate Options Layout -->
        <LinearLayout
            android:id="@+id/layout_video_rotate_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/btn_action_rotate_90"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_rotate_modern"
                    app:tint="#FFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Rotate 90°"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Crop Options Layout -->
        <LinearLayout
            android:id="@+id/layout_video_crop_gesture_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/btn_crop_preset_free"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Free"
                        android:textColor="#00FF00"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/btn_crop_preset_1_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1:1"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/btn_crop_preset_16_9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:9"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/btn_crop_preset_9_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9:16"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/btn_crop_preset_4_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4:3"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/btn_reset_crop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESET"
                        android:textColor="#FF5555"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Aspect-Ratio Options Layout -->
        <LinearLayout
            android:id="@+id/layout_video_aspect_ratio_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/btn_crop_free"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Free"
                        android:textColor="#00FF00"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/btn_crop_1_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1:1"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/btn_crop_16_9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:9"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/btn_crop_9_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9:16"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:id="@+id/btn_crop_4_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4:3"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Options Bar -->
    <FrameLayout
        android:id="@+id/video_editor_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#161616"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Main Options (Trim, Sound, Rotate, Crop, Aspect-Ratio) -->
        <LinearLayout
            android:id="@+id/layout_video_main_options"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="visible">

            <!-- Trim -->
            <LinearLayout
                android:id="@+id/btn_main_trim"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_trim_modern"
                    app:tint="#FFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Trim"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Sound -->
            <LinearLayout
                android:id="@+id/btn_main_sound"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_volume_up"
                    app:tint="#FFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sound"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Rotate -->
            <LinearLayout
                android:id="@+id/btn_main_rotate"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_rotate_modern"
                    app:tint="#FFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Rotate"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Crop -->
            <LinearLayout
                android:id="@+id/btn_main_crop"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_crop_modern"
                    app:tint="#FFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Crop"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Aspect-Ratio -->
            <LinearLayout
                android:id="@+id/btn_main_aspect_ratio"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_aspect_ratio_modern"
                    app:tint="#FFFFFF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Aspect-Ratio"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sub Actions Bar (Title, Checkmark) -->
        <RelativeLayout
            android:id="@+id/layout_video_sub_actions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_sub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Sub Title"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_sub_done"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:scaleType="center"
                android:src="@drawable/ic_check"
                android:background="?attr/selectableItemBackground"
                app:tint="#00FF00" />
        </RelativeLayout>
    </FrameLayout>

    <!-- Progress / Loading Overlay -->
    <LinearLayout
        android:id="@+id/layout_video_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A0000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:id="@+id/progress_bar_export"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#00FF00" />

        <TextView
            android:id="@+id/tv_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Exporting video... 0%"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
