<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:clipToPadding="false"
    android:paddingBottom="90dp"
    android:scrollbars="vertical"
    android:fadeScrollbars="false"
    android:scrollbarSize="8dp"
    android:scrollbarThumbVertical="@drawable/bg_scrollbar_thumb"
    android:scrollbarTrackVertical="@drawable/bg_scrollbar_track">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <!-- Section 1: "All" -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All"
            android:textColor="#A0A0A0"
            android:textSize="15sp"
            android:textStyle="normal"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_albums_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_album_card" />

        <!-- Section 2: "Apps" -->
        <TextView
            android:id="@+id/tv_header_apps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apps"
            android:textColor="#A0A0A0"
            android:textSize="15sp"
            android:textStyle="normal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_albums_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_album_card" />

        <!-- Section 3: "More Albums" -->
        <TextView
            android:id="@+id/tv_header_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="More Albums"
            android:textColor="#A0A0A0"
            android:textSize="15sp"
            android:textStyle="normal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_albums_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_album_card" />

        <!-- Trash Bin -->
        <LinearLayout
            android:id="@+id/btn_trash_bin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/bg_bottom_sheet"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">
            
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_delete_modern2"
                app:tint="#FFFFFF" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Recently Deleted"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />
                
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
                
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
