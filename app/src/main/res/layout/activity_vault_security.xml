<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Header Section -->
    <ImageView
        android:id="@+id/iv_lock_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="64dp"
        android:src="@android:drawable/ic_secure"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Private Safe"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/iv_lock_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Enter your PIN"
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PIN Indicators -->
    <LinearLayout
        android:id="@+id/ll_pin_indicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <View android:id="@+id/dot_1" android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_pin_dot_empty" android:layout_marginHorizontal="8dp" />
        <View android:id="@+id/dot_2" android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_pin_dot_empty" android:layout_marginHorizontal="8dp" />
        <View android:id="@+id/dot_3" android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_pin_dot_empty" android:layout_marginHorizontal="8dp" />
        <View android:id="@+id/dot_4" android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_pin_dot_empty" android:layout_marginHorizontal="8dp" />
    </LinearLayout>

    <!-- Error text -->
    <TextView
        android:id="@+id/tv_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Incorrect PIN"
        android:textColor="#FF5252"
        android:textSize="14sp"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/ll_pin_indicators"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Number Pad -->
    <GridLayout
        android:id="@+id/grid_numpad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:columnCount="3"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@id/tv_error"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.2">

        <!-- Row 1 -->
        <TextView style="@style/PinPadButton" android:text="1" android:id="@+id/btn_pin_1" />
        <TextView style="@style/PinPadButton" android:text="2" android:id="@+id/btn_pin_2" />
        <TextView style="@style/PinPadButton" android:text="3" android:id="@+id/btn_pin_3" />

        <!-- Row 2 -->
        <TextView style="@style/PinPadButton" android:text="4" android:id="@+id/btn_pin_4" />
        <TextView style="@style/PinPadButton" android:text="5" android:id="@+id/btn_pin_5" />
        <TextView style="@style/PinPadButton" android:text="6" android:id="@+id/btn_pin_6" />

        <!-- Row 3 -->
        <TextView style="@style/PinPadButton" android:text="7" android:id="@+id/btn_pin_7" />
        <TextView style="@style/PinPadButton" android:text="8" android:id="@+id/btn_pin_8" />
        <TextView style="@style/PinPadButton" android:text="9" android:id="@+id/btn_pin_9" />

        <!-- Row 4 -->
        <ImageView
            android:id="@+id/btn_pin_fingerprint"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@android:drawable/ic_menu_camera" 
            android:padding="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_margin="8dp"
            app:tint="#AAAAAA"
            android:visibility="invisible" />
            <!-- Will replace icon with fingerprint drawable if needed, or leave generic -->
        
        <TextView style="@style/PinPadButton" android:text="0" android:id="@+id/btn_pin_0" />
        
        <ImageView
            android:id="@+id/btn_pin_delete"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@android:drawable/ic_input_delete"
            android:padding="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_margin="8dp"
            app:tint="#FFFFFF" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
